# Seyyahname AI English Coach: copy this file to .env (same folder as api.php, or one folder above it,
# outside public_html, which is safer) and fill in the values. Never share .env.

# Required: the master PIN / password the lock screen asks for. Use 8+ characters.
APP_SECRET_PIN=change-me

# Recommended: any long random text. It signs the login cookie; change it to sign everyone out.
APP_SESSION_SECRET=

# Optional: Google Gemini API key (https://aistudio.google.com/apikey). Enables the Coach chat and
# AI feedback; without it the app uses its offline feedback engine.
GEMINI_API_KEY=
# Gemini model. "gemini-flash-latest" always points to Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Optional: folder for profile.json, vocabulary.md, error_ledger.md and sessions/.
# Relative to api.php, or an absolute path outside public_html (safest).
DATA_DIR=data
