# Copy to .env next to server.js and fill in. Never commit or share .env.

# Required: the master PIN / password the lock screen asks for. Use 8+ characters.
APP_SECRET_PIN=change-me

# Recommended: a long random string that signs the lumos_auth cookie (rotate it to sign everyone out).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=

# Optional: enables the Coach chat and Claude feedback. Without it the app uses offline feedback.
ANTHROPIC_API_KEY=
# Claude model id (default: claude-opus-5-5).
COACH_MODEL=claude-opus-5-5

# Port of the Node server (Nginx proxies to it). HOSTNAME is set in ecosystem.config.cjs.
PORT=3001

# Where profile.json, vocabulary.md, error_ledger.md and sessions/ live (relative to server.js).
COACH_DATA_DIR=./data
