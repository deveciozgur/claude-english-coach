# Copy to .env (same folder as package.json) and fill in. Never commit or share .env.

# Required: the PIN / password the lock screen asks for. Use 8+ characters.
APP_SECRET_PIN=change-me

# Recommended: a long random string that signs the login cookie, so logins survive restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=

# Optional: enables the AI coach chat and Claude feedback. Without it the app uses offline feedback.
ANTHROPIC_API_KEY=
# Claude model id (default: claude-opus-5-5).
COACH_MODEL=claude-opus-5-5

# Port the Node server listens on. Behind Nginx/Apache, point the proxy here.
PORT=3001
# 127.0.0.1 when a reverse proxy sits in front; 0.0.0.0 to listen on all interfaces.
HOST=127.0.0.1

# Where profile.json, vocabulary.md, error_ledger.md and sessions/ live (relative to this folder).
COACH_DATA_DIR=./data
